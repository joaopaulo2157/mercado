{
  "name": "supermercado-central",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "install:ci": "npm install --no-audit --no-fund",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern legacy",
    "build:vercel": "next build"
  },
  "dependencies": {
    "motion": "^12.23.12",
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "@types/pg": "^8.15.5"
  },
  "type": "module",
  "displayName": "Supermercado Central",
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
