# =============================================================
# SC SUPERMERCADO CENTRAL V6
# GitHub + Supabase PostgreSQL + Vercel
# =============================================================

# Banco PostgreSQL do Supabase.
# No Supabase: Project Settings / Database / Connect / Connection string.
# Para Vercel/serverless, prefira a URL do Transaction Pooler (porta 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@POOLER_HOST:6543/postgres?sslmode=require

# Limite pequeno e seguro para funções serverless.
DB_CONNECTION_LIMIT=5

# URL pública da loja.
NEXT_PUBLIC_SITE_URL=https://seu-projeto.vercel.app

# Proteção contra força bruta do painel administrativo.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_LOCK_MINUTES=15

# Nesta versão NÃO existem ADMIN_PASSWORD, ADMIN_EMAILS, ADMIN_SESSION_SECRET
# nem código 2FA. O primeiro administrador é criado em /admin/setup e depois
# o acesso passa a ser feito apenas com e-mail + senha.
