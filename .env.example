# =============================================================
# SUPERMERCADO CENTRAL - CONFIGURACAO PORTAVEL
# Copie este arquivo para .env.local (desenvolvimento) ou cadastre
# as mesmas variaveis no painel da sua hospedagem.
# =============================================================

# -------------------------------------------------------------
# BANCO MYSQL / MARIADB
# Use DATABASE_URL OU as variaveis DB_* abaixo.
# -------------------------------------------------------------

# Opcao 1: URL completa (provedores gerenciados)
# DATABASE_URL=mysql://usuario:senha@host:3306/supermercado_central

# Opcao 2: dados separados (cPanel, Plesk, VPS, servidor proprio)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=supermercado_user
DB_PASSWORD=troque-esta-senha
DB_NAME=supermercado_central

# Ative somente se o provedor do banco exigir SSL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10

# -------------------------------------------------------------
# LOGIN DO PAINEL ADMINISTRATIVO
# -------------------------------------------------------------
AUTH_MODE=local
ADMIN_EMAILS=admin@seudominio.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Gere um segredo longo e aleatorio (recomendado: 64+ caracteres).
# Nao use o mesmo valor da senha administrativa.
ADMIN_SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# -------------------------------------------------------------
# V5 - URL PUBLICA E PROTECAO DO LOGIN
# -------------------------------------------------------------
# Informe o dominio real em producao. Na Vercel, VERCEL_PROJECT_PRODUCTION_URL
# tambem e reconhecida automaticamente.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Protecao contra tentativas repetidas no painel.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_LOCK_MINUTES=15

# 2FA TOTP real para a conta proprietaria (opcional, recomendado em producao).
# Use uma chave Base32 de pelo menos 16 caracteres cadastrada em um app
# autenticador (Google Authenticator, Microsoft Authenticator, 1Password etc.).
# ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
